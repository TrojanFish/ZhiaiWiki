# ==============================================================================
# 知癌维基 ZhiaiWiki 肿瘤循证智能平台 · 全栈生产与容器部署环境配置规范 (.env.example)
# ==============================================================================
# 部署说明：
# 1. 单机 Docker 部署：复制本文件为根目录 .env：cp .env.example .env
# 2. 启动生产容器服务：docker compose -f docker-compose.prod.yml up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 生产数据库配置 (PostgreSQL 16 with pgvector)
# ------------------------------------------------------------------------------
# 容器内部数据库名与初始凭证（生产部署请务必修改密码！）
POSTGRES_USER="zhiaiwiki_admin"
POSTGRES_PASSWORD="ChangeMe_DbPassword_2026!"
POSTGRES_DB="zhiaiwiki_production"

# Next.js 应用直连数据库连接串（如果是外部独立自建/宝塔数据库，请在此直接配置）
DATABASE_URL="postgresql://zhiaiwiki_admin:ChangeMe_DbPassword_2026!@localhost:5432/zhiaiwiki_production?schema=public"

# ------------------------------------------------------------------------------
# 2. 谷歌 Gemini 多模态大模型 API Key
# ------------------------------------------------------------------------------
# 获取地址: https://aistudio.google.com/app/apikey (Google AI Studio 免费申请)
# 说明: 用于影像/病理报告 OCR 解析、分期校对、随访报告生成与文献要素结构化抽取
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. 后台管理员鉴权凭证 (Admin Evidence Studio · 证据中台)
# ------------------------------------------------------------------------------
# 后台登录用户名（默认: admin）
# ⚠️ 重要: 此凭证同时用于 Next.js 前端管理员后台 AND 后端 FastAPI 证据写入端点
#   (POST /api/evidence/seed, /evidence/fetch-pubmed, /evidence/fetch-europe-pmc 等)
ADMIN_USERNAME="admin"

# 后台登录密码
# 本地开发说明: 本地调试若不填写或使用默认值，初始密码为: ZhiaiWiki2026!
# 生产部署说明: 【生产发布强制要求】必须修改为高强度密码，系统检测到默认密码会主动拦截阻止登录！
# 生成命令示例: openssl rand -base64 24
ADMIN_PASSWORD="ChangeMe_Production_Admin_Password_2026!"

# 后台与用户会话 JWT/HMAC 签名密钥（【生产发布强制要求】：必须修改为 32 位以上随机强密钥）
# 生成命令示例: openssl rand -base64 32
ADMIN_SECRET="replace_with_a_secure_random_32_char_secret_key_2026"

# ------------------------------------------------------------------------------
# 4. 访客匿名会话与防篡改密钥 (Guest Session Security)
# ------------------------------------------------------------------------------
GUEST_SESSION_SECRET="replace_with_another_secure_guest_hmac_secret_2026"

# ------------------------------------------------------------------------------
# 5. Cookie 安全策略 (Cookie Secure Policy)
# ------------------------------------------------------------------------------
# auto: 自适应（HTTPS 请求启用 secure，HTTP 不启用，推荐）
# true: 强制启用 Secure（要求全站配置 HTTPS/SSL）
# false: 禁用 Secure（仅纯 HTTP 或本地测试使用）
COOKIE_SECURE="auto"

# ------------------------------------------------------------------------------
# 6. 端口映射配置 (Docker Nginx Reverse Proxy Ports)
# ------------------------------------------------------------------------------
PROD_HTTP_PORT="80"
PROD_HTTPS_PORT="443"

# ------------------------------------------------------------------------------
# 7. 站点公开基准 URL (Canonical Public URL)
# ------------------------------------------------------------------------------
# 用于 OpenGraph 卡片、分享预览与 PWA 规范化链接
# 示例: https://zhiaiwiki.org 或 http://YOUR_SERVER_IP
NEXT_PUBLIC_APP_URL="https://zhiaiwiki.org"

# ------------------------------------------------------------------------------
# 8. 官方医学数据库与文献检索 (PubMed / Europe PMC / MEDLINE)
# ------------------------------------------------------------------------------
# 说明：系统已内置对接欧洲生物信息研究所 (EMBL-EBI / Europe PMC) 官方开放科研 API。
# 该公共服务每日自动同步美国国家医学图书馆 PubMed/MEDLINE 核心数据库。
# 【无需注册、免申请 API Key、开箱即用】，系统会自动通过 Next.js 服务端路由进行流控与清洗。

# ------------------------------------------------------------------------------
# 9. 后端 FastAPI 专用配置 (Backend-only Settings)
# ------------------------------------------------------------------------------
# FastAPI 患者 JWT 会话签名密钥（与 Next.js ADMIN_SECRET 相互独立）
# 【生产发布强制要求】：必须设置为至少 32 位随机强密钥，否则生产环境将拒绝启动！
# 生成命令示例: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace_with_a_different_backend_jwt_secret_32_chars_minimum"

# OpenAI 兼容大模型 API Key（用于后端 FastAPI /api/analysis/generate 端点）
# 注意: Next.js 前端的 OCR/报告生成使用 GEMINI_API_KEY，与本配置无关。
# 若仅使用 Gemini 前端流程，可将此项留空（后端会打印警告但不阻止启动）。
# 支持兼容 OpenAI API 格式的自建模型（修改 OPENAI_BASE_URL 即可接入）。
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
LLM_MODEL_NAME="gpt-4-turbo-preview"
