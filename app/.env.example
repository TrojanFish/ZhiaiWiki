# ==============================================================================
# 知癌维基 ZhiaiWiki 肿瘤循证智能平台 · 环境配置规范 (.env.example)
# ==============================================================================
# 说明：在本地调试或部署上线前，请将本文件复制为 .env 文件：
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 数据库配置 (PostgreSQL Database with pgvector)
# ------------------------------------------------------------------------------
# Prisma 数据库连接串（支持 PostgreSQL 14+ / 16+）
# 格式: postgresql://<用户名>:<密码>@<主机>:<端口>/<数据库名>?schema=public
# 提示: 如果使用宝塔面板、Docker 或自建 PostgreSQL，请替换为真实数据库账密
# 本地测试说明: 本地若未安装/启动 PostgreSQL，系统会自动平滑降级为演示模式
# （除文献正式持久化入库外，全站8大癌种推演、PubMed检索、AI解读、爱心接力等均正常可用）
DATABASE_URL="postgresql://postgres:password@localhost:5432/zhiaiwiki?schema=public"

# ------------------------------------------------------------------------------
# 2. 谷歌 Gemini 多模态大模型 API Key (AI 报告结构化提取与循证报告生成)
# ------------------------------------------------------------------------------
# 获取地址: https://aistudio.google.com/app/apikey (Google AI Studio 免费申请)
# 权限说明: 用于术后病理报告 OCR / 影像指标提取、智能分期校对、人话解读与文献要素抽取
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. 后台管理员鉴权凭证 (Admin Evidence Studio · 证据中台)
# ------------------------------------------------------------------------------
# 后台登录用户名（默认: admin）
ADMIN_USERNAME="admin"

# 后台登录密码
# 本地开发说明: 本地调试若不填写或使用默认值，初始密码为: ZhiaiWiki2026!
# 生产部署说明: 【生产发布强制要求】必须修改为高强度密码，系统检测到默认密码会主动拦截阻止登录！
ADMIN_PASSWORD="ChangeMe_Production_Password_2026!"

# 后台与会话 JWT/HMAC 签名密钥（【生产发布强制要求】：必须随机生成 32 位以上字符串）
# 提示: 可通过命令生成随机密钥: openssl rand -base64 32
ADMIN_SECRET="replace_with_a_secure_random_32_char_secret_key_2026"

# ------------------------------------------------------------------------------
# 4. 患者免密与访客会话安全 (Guest & Session Security)
# ------------------------------------------------------------------------------
# 访客匿名会话与防篡改 HMAC 密钥
GUEST_SESSION_SECRET="replace_with_another_secure_guest_hmac_secret_2026"

# ------------------------------------------------------------------------------
# 5. Cookie 安全策略 (Cookie Secure Policy)
# ------------------------------------------------------------------------------
# 可选值:
#   auto  : 生产环境下如果请求来自 HTTPS 则启用 secure，来自 HTTP 则自适应（推荐）
#   true  : 强制启用 Secure 属性（仅允许 HTTPS 传输，配置 SSL 证书后推荐）
#   false : 禁用 Secure 属性（仅在纯 HTTP 或内网测试时使用）
COOKIE_SECURE="auto"

# ------------------------------------------------------------------------------
# 6. 站点公开基准 URL (Canonical App URL)
# ------------------------------------------------------------------------------
# 用于 OpenGraph 分享卡片、PWA 规范化元数据和绝对链接生成
# 本地开发: http://localhost:3000
# 生产示例: https://zhiaiwiki.org 或 http://YOUR_SERVER_IP:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 7. 官方医学数据库与文献检索 (PubMed / Europe PMC / MEDLINE)
# ------------------------------------------------------------------------------
# 说明：系统已内置对接欧洲生物信息研究所 (EMBL-EBI / Europe PMC) 官方开放科研 API。
# 该公共服务每日自动同步美国国家医学图书馆 PubMed/MEDLINE 核心数据库。
# 【无需注册、免申请 API Key、开箱即用】，系统会自动通过 Next.js 服务端路由进行流控与清洗。
