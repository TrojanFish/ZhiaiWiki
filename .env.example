# ==============================================================================
# OncoPath 肿瘤循证推演平台 · 全栈生产与容器部署环境配置规范 (.env.example)
# ==============================================================================
# 部署说明：
# 1. 单机 Docker 部署：复制本文件为根目录 .env：cp .env.example .env
# 2. 启动生产容器服务：docker compose -f docker-compose.prod.yml up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 生产数据库配置 (PostgreSQL 16 with pgvector)
# ------------------------------------------------------------------------------
# 容器内部数据库名与初始凭证（生产部署请务必修改密码！）
POSTGRES_USER="oncopath_admin"
POSTGRES_PASSWORD="ChangeMe_DbPassword_2026!"
POSTGRES_DB="oncopath_production"

# Next.js 应用直连数据库连接串（如果是外部独立自建/宝塔数据库，请在此直接配置）
DATABASE_URL="postgresql://oncopath_admin:ChangeMe_DbPassword_2026!@localhost:5432/oncopath_production?schema=public"

# ------------------------------------------------------------------------------
# 2. 谷歌 Gemini 多模态大模型 API Key
# ------------------------------------------------------------------------------
# 获取地址: https://aistudio.google.com/app/apikey
# 说明: 用于影像/病理报告 OCR 解析、实性成分推算与随访报告生成
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. 后台管理员鉴权凭证 (Admin Evidence Studio)
# ------------------------------------------------------------------------------
# 后台登录用户名（默认: admin）
ADMIN_USERNAME="admin"

# 后台登录密码（【生产发布强制要求】：必须修改为高强度密码，禁止使用默认密码！）
ADMIN_PASSWORD="ChangeMe_Production_Admin_Password_2026!"

# 后台与用户会话 JWT/HMAC 签名密钥（【生产发布强制要求】：必须修改为 32 位以上随机强密钥）
# 生成命令示例: openssl rand -base64 32
ADMIN_SECRET="replace_with_a_secure_random_32_char_secret_key_2026"

# ------------------------------------------------------------------------------
# 4. 访客匿名会话与防篡改密钥 (Guest Session Security)
# ------------------------------------------------------------------------------
GUEST_SESSION_SECRET="replace_with_another_secure_guest_hmac_secret_2026"

# ------------------------------------------------------------------------------
# 5. Cookie 安全策略 (Cookie Secure Policy)
# ------------------------------------------------------------------------------
# auto: 自适应（HTTPS 请求启用 secure，HTTP 不启用）
# true: 强制启用 Secure（要求全站 HTTPS/SSL）
# false: 禁用 Secure
COOKIE_SECURE="auto"

# ------------------------------------------------------------------------------
# 6. 端口映射配置 (Docker Nginx Reverse Proxy Ports)
# ------------------------------------------------------------------------------
PROD_HTTP_PORT="80"
PROD_HTTPS_PORT="443"

# ------------------------------------------------------------------------------
# 7. 站点公开基准 URL (Canonical Public URL)
# ------------------------------------------------------------------------------
# 用于 OpenGraph 卡片、分享预览与 PWA 规范化链接
# 示例: https://oncopath.yourdomain.com 或 http://YOUR_SERVER_IP
NEXT_PUBLIC_APP_URL="https://oncopath.yourdomain.com"
